{
  "name": "copy-cart",
  "productName": "Copy Cart",
  "description": "Copy files using order import",
  "author": "Dennis Bogdanov",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "make:nsis": "npm run build && electron-builder --win --publish never",
    "publish:nsis": "npm run build && electron-builder --win --publish always",
    "verify:settings-migration": "electron scripts/verify-settings-migration.mjs",
    "verify:updater": "electron scripts/verify-updater-imports.mjs",
    "verify:import": "electron scripts/verify-multi-import.mjs"
  },
  "main": "electron/main.ts",
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@primevue/forms": "^4.4.1",
    "csv-parser": "^3.2.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "electron": "^38.2.1",
    "electron-builder": "^26.15.3",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.ddbogdanov.copycart",
    "productName": "Copy Cart",
    "artifactName": "CopyCart-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ddbogdanov",
        "repo": "CopyCart"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ddbogdanov/CopyCart.git"
  }
}
