{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "out/electron",
    // No "rootDir" — shared/ intentionally lives outside electron/; this config
    // is type-check only, packaging layout is owned by the build step.
    "module": "ESNext",
    "target": "ES2020",
    "sourceMap": true,
    "esModuleInterop": true,
	"moduleResolution": "bundler",
	"allowJs": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.js", "shared/**/*.ts"]
}